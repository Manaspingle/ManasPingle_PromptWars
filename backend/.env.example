# Google Gemini API Key (Required in production/real mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Allowed Origin for CORS (e.g., http://localhost:5173 for local Vite dev, or production frontend URL)
ALLOWED_ORIGIN=http://localhost:5173

# Port for backend Express server (defaults to 3000)
PORT=3000
